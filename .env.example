# Copy to .env.local for local development. Production values are managed by Railway.

# PostgreSQL connection string (Railway injects this automatically in production).
DATABASE_URL=postgresql://user:***@host:5432/database

# Admin auth (required — see src/lib/auth.ts)
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-64-hex-chars

# ---------------------------------------------------------------------------
# LLM provider (market scanning + recovery assistant)
# Default provider is Google Gemini. To switch providers, set LLM_PROVIDER and
# the matching key below — no code change required.
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini            # gemini | openai-compatible

# Gemini (recommended — native Google Search grounding, no training on paid tier)
GEMINI_API_KEY=               # from https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash        # assistant model
GEMINI_SCAN_MODEL=gemini-2.5-flash-lite  # cheap model for market scans

# OpenAI-compatible alternative (OpenRouter / Groq / DeepSeek / Together)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=meta-llama/llama-3.1-8b-instruct
